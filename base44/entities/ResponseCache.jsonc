{
  "name": "ResponseCache",
  "type": "object",
  "properties": {
    "cache_key": {
      "type": "string",
      "description": "SHA-256 hex of request"
    },
    "model": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Cached response content"
    },
    "prompt_tokens": {
      "type": "number",
      "default": 0
    },
    "completion_tokens": {
      "type": "number",
      "default": 0
    },
    "total_tokens": {
      "type": "number",
      "default": 0
    },
    "hits": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Lightweight semantic vector of last user message (256-dim, sparse)"
    },
    "last_user_text": {
      "type": "string",
      "description": "Last user message text used for semantic matching"
    },
    "is_single_turn": {
      "type": "boolean",
      "default": false,
      "description": "Whether the request was single-turn (eligible for semantic match)"
    }
  },
  "required": [
    "cache_key",
    "content"
  ]
}