{
  "name": "UsageStats",
  "type": "object",
  "properties": {
    "api_key_id": {
      "type": "string",
      "description": "The API key ID"
    },
    "model": {
      "type": "string",
      "description": "Model used"
    },
    "prompt_tokens": {
      "type": "number",
      "default": 0
    },
    "completion_tokens": {
      "type": "number",
      "default": 0
    },
    "total_tokens": {
      "type": "number",
      "default": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "api_key_id",
    "model"
  ]
}